body { font-family: 'Helvetica', 'Arial', sans-serif; margin: 0; padding-bottom: 80px; background: #f9f9f9; }
header { background: #333; color: white; padding: 20px; text-align: center; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 15px; }
.card { background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
.float-btn {
    position: fixed; bottom: 20px; left: 20px; right: 20px;
    background: #00b900; color: white; padding: 15px; text-align: center;
    border-radius: 50px; text-decoration: none; font-weight: bold;
}
